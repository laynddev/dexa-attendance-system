# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:password@localhost:5432/attendance_db?schema=public"
JWT_SECRET="attendance-development-secret-change-later"
PORT=3003
CORS_ORIGINS=http://localhost:5173,http://localhost:5174